{
  "name": "cngn-typescript-library",
  "version": "4.0.0",
  "description": "TypeScript client for the cNGN API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "sideEffects": false,
  "scripts": {
    "build": "npm run typecheck && npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --legal-comments=external --outfile=dist/index.js && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --legal-comments=external --outfile=dist/index.cjs",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:live:read": "npm run build && node test/live-readonly.mjs",
    "test:live:mutate": "npm run build && node test/live-mutations.mjs",
    "check": "npm run build && npm run typecheck:test && npm test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrappedcbdc/cngn-typescript-library.git"
  },
  "homepage": "https://github.com/wrappedcbdc/cngn-typescript-library",
  "author": "Convexity <contact@cngn.co>",
  "license": "ISC",
  "keywords": [
    "cngn",
    "typescript",
    "stablecoin",
    "payments"
  ],
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "bip39": "3.1.0",
    "bs58": "6.0.0",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
